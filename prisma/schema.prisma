generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String         @id @map("_id")
  name           String
  email          String         @unique
  cpf            String?        @unique
  phone          String?        @unique
  password       String?        // Add password field directly to User
  emailVerified  Boolean        @default(false)
  phoneVerified  Boolean        @default(false)
  approvalStatus ApprovalStatus @default(PENDING)
  image          String?
  kycStatus      KYCStatus      @default(PENDING)
  kycData        Json?
  // KYC Document fields (for CPF - individual users)
  documentType   DocumentType?
  documentNumber String?
  documentFront  String?        // URL to front document image
  documentBack   String?        // URL to back document image
  documentSelfie String?        // URL to selfie with document
  // KYC Document fields (for CNPJ - company users)
  contratoSocial String?        // URL to Contrato Social PDF
  cartaoCNPJ     String?        // URL to Cartão CNPJ PDF
  cnhSocioControlado String?   // URL to CNH do sócio controlado PDF
  kycSubmittedAt DateTime?
  kycReviewedAt  DateTime?
  kycRejectionReason String?
  // Admin notification tracking
  adminNotificationLastSeenAt DateTime?
  // 2FA fields
  twoFactorEnabled    Boolean @default(false)
  twoFactorSecret     String?
  twoFactorBackupCodes String[] @default([])
  createdAt      DateTime
  updatedAt      DateTime
  accounts       Account[]
  balances       Balance[]
  deposits       Deposit[]
  orders         Order[]
  p2pOffers      P2POffer[]
  buyerTrades    P2PTrade[]     @relation("BuyerTrades")
  sellerTrades   P2PTrade[]     @relation("SellerTrades")
  sessions       Session[]
  transactions   Transaction[]
  withdrawals    Withdrawal[]
  notifications  Notification[]
  notes          UserNote[]
  communicationLogs CommunicationLog[]

  @@map("user")
}

model Session {
  id        String   @id @map("_id")
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @map("_id")
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String          @id @map("_id")
  identifier String          // email or phone number
  value      String          // verification code (4 digits)
  type       VerificationType // EMAIL, PHONE, PASSWORD_RESET
  purpose    String?         // Additional context like "signup", "password_reset"
  attempts   Int             @default(0)
  maxAttempts Int            @default(3)
  expiresAt  DateTime
  createdAt  DateTime?       @default(now())
  updatedAt  DateTime?       @updatedAt

  @@map("verification")
}

enum VerificationType {
  EMAIL
  PHONE
  PASSWORD_RESET
}

model Balance {
  id        String   @id @default(cuid())
  userId    String
  currency  String
  amount    Decimal  @db.Decimal(20, 8)
  locked    Decimal  @default(0) @db.Decimal(20, 8)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, currency])
  @@map("balance")
}

model Deposit {
  id            String        @id @default(cuid())
  userId        String
  amount        Decimal       @db.Decimal(20, 2)
  currency      String        @default("BRL")
  status        DepositStatus @default(PENDING)
  paymentMethod String
  externalId    String?
  proofUrl      String?
  confirmedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  transactionId String?       @unique
  transaction   Transaction?  @relation(fields: [transactionId], references: [id])
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Payment integration fields
  paymentId     String?       // External payment provider payment ID
  paymentStatus String?       // External payment provider payment status
  paymentAmount Decimal?      @db.Decimal(20, 2) // Actual amount paid
  fee           Decimal?      @db.Decimal(20, 2) // Processing fee charged
  pixQrCode    String?       // PIX QR code data
  pixQrCodeBase64 String?    // PIX QR code image in base64

  @@map("deposit")
}

model Withdrawal {
  id            String           @id @default(cuid())
  userId        String
  amount        Decimal          @db.Decimal(20, 2)
  currency      String           @default("BRL")
  status        WithdrawalStatus @default(PENDING)
  paymentMethod String
  externalId    String?
  bankAccount   Json?
  processedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  transactionId String?          @unique
  transaction   Transaction?     @relation(fields: [transactionId], references: [id])
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  // New fields for PIX and USDT withdrawals
  type          String?          // "PIX" or "USDT"
  fee           Decimal?         @db.Decimal(20, 2) // Withdrawal fee
  netAmount     Decimal?         @db.Decimal(20, 2) // Amount after fee
  
  // PIX specific fields
  pixKey        String?          // PIX key (email, CPF, phone)
  protocol      String?          // PIX protocol number
  
  // USDT specific fields
  walletAddress String?          // Destination wallet address
  network       String?          // Network (TRC20, ERC20, BSC)
  hash          String?          // Transaction hash

  @@map("withdrawal")
}

model Order {
  id              String       @id @default(cuid())
  userId          String
  type            OrderType
  baseCurrency    String
  quoteCurrency   String
  amount          Decimal      @db.Decimal(20, 8)
  price           Decimal      @db.Decimal(20, 2)
  total           Decimal      @db.Decimal(20, 2)
  status          OrderStatus  @default(PENDING)
  externalOrderId String?
  executedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  transactionId   String?      @unique
  transaction     Transaction? @relation(fields: [transactionId], references: [id])
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("order")
}

model P2POffer {
  id             String      @id @default(cuid())
  userId         String
  type           OfferType
  cryptoCurrency String
  fiatCurrency   String      @default("BRL")
  cryptoAmount   Decimal     @db.Decimal(20, 8)
  fiatAmount     Decimal     @db.Decimal(20, 2)
  price          Decimal     @db.Decimal(20, 2)
  status         OfferStatus @default(ACTIVE)
  paymentMethods Json
  minTrade       Decimal     @db.Decimal(20, 2)
  maxTrade       Decimal     @db.Decimal(20, 2)
  expiresAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades         P2PTrade[]

  @@map("p2p_offer")
}

model P2PTrade {
  id                  String       @id @default(cuid())
  offerId             String
  buyerId             String
  sellerId            String
  cryptoAmount        Decimal      @db.Decimal(20, 8)
  fiatAmount          Decimal      @db.Decimal(20, 2)
  status              TradeStatus  @default(PENDING)
  paymentProof        String?
  cryptoReleased      Boolean      @default(false)
  fiatConfirmed       Boolean      @default(false)
  disputeReason       String?
  expiresAt           DateTime
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  buyerTransactionId  String?      @unique
  sellerTransactionId String?      @unique
  buyer               User         @relation("BuyerTrades", fields: [buyerId], references: [id])
  buyerTransaction    Transaction? @relation("BuyerTransaction", fields: [buyerTransactionId], references: [id])
  offer               P2POffer     @relation(fields: [offerId], references: [id], onDelete: Cascade)
  seller              User         @relation("SellerTrades", fields: [sellerId], references: [id])
  sellerTransaction   Transaction? @relation("SellerTransaction", fields: [sellerTransactionId], references: [id])

  @@map("p2p_trade")
}

model Transaction {
  id          String          @id @default(cuid())
  userId      String
  type        TransactionType
  amount      Decimal         @db.Decimal(20, 8)
  currency    String
  balance     Decimal         @db.Decimal(20, 8)
  description String
  metadata    Json?
  createdAt   DateTime        @default(now())
  deposit     Deposit?
  order       Order?
  buyerTrade  P2PTrade?       @relation("BuyerTransaction")
  sellerTrade P2PTrade?       @relation("SellerTransaction")
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  withdrawal  Withdrawal?

  @@map("transaction")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum KYCStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DocumentType {
  RG
  HABILITACAO
  CNH
  PASSPORT
}

enum DepositStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum OrderType {
  BUY
  SELL
}

enum OrderStatus {
  PENDING
  EXECUTING
  COMPLETED
  FAILED
  CANCELLED
}

enum OfferType {
  BUY
  SELL
}

enum OfferStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

enum TradeStatus {
  PENDING
  PAYMENT_SENT
  PAYMENT_CONFIRMED
  CRYPTO_RELEASED
  COMPLETED
  DISPUTED
  CANCELLED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  BUY_CRYPTO
  SELL_CRYPTO
  P2P_TRADE
  FEE
  REFUND
}

model WebhookEvent {
  id            String   @id @default(cuid())
  eventType     String   // e.g., "transaction.completed"
  source        String   @default("nutzpay") // "nutzpay", "test", etc.
  payload       Json     // Full webhook payload
  transactionId String?  // NutzPay transaction ID
  externalId    String?  // External ID from webhook
  status        String?  // Status from webhook (COMPLETED, PENDING, FAILED)
  orderId       String?  // Related order ID if found
  processed     Boolean  @default(false) // Whether webhook was successfully processed
  error         String?  // Error message if processing failed
  ipAddress     String?  // IP address of webhook sender
  userAgent     String?  // User agent of webhook sender
  signatureValid Boolean? // Whether signature was valid
  createdAt     DateTime @default(now())

  @@index([transactionId])
  @@index([externalId])
  @@index([orderId])
  @@index([createdAt])
  @@map("webhook_event")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // e.g., "balance_adjusted", "deposit_completed", etc.
  title     String
  message   String
  read      Boolean  @default(false)
  metadata  Json?    // Additional data (e.g., transactionId, amount, etc.)
  createdAt DateTime @default(now())
  readAt    DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
  @@map("notification")
}

// Admin audit log (who did what, when)
model AdminAuditLog {
  id          String   @id @default(cuid())
  adminId     String   // admin user id (e.g. admin_001)
  adminEmail  String?
  action      String   // e.g. "transaction_approve", "balance_adjust", "money_controls"
  resourceType String  // e.g. "transaction", "user", "withdrawal"
  resourceId  String?
  oldValue    Json?    // previous state (optional)
  newValue    Json?    // new state (optional)
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([adminId])
  @@index([resourceType, resourceId])
  @@index([createdAt])
  @@map("admin_audit_log")
}

// Internal notes/tags on user accounts (support)
model UserNote {
  id        String   @id @default(cuid())
  userId    String
  adminId   String
  note      String   @db.Text
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_note")
}

// Support issues queue (lightweight)
model SupportIssue {
  id            String   @id @default(cuid())
  userId        String?
  transactionId String?
  title         String
  description   String?   @db.Text
  status        String   @default("open") // open, in_progress, resolved
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([userId])
  @@index([createdAt])
  @@map("support_issue")
}

// Communication log (emails sent to users)
model CommunicationLog {
  id        String   @id @default(cuid())
  userId    String
  type      String   // receipt, notification, etc.
  subject   String?
  sentAt    DateTime @default(now())
  metadata  Json?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sentAt])
  @@map("communication_log")
}

// Admin email alert preferences (singleton: one row)
model AdminAlertSettings {
  id                    String   @id @default(cuid())
  email                 String?  @default("rian981265@gmail.com") // legacy single email; prefer emails
  emails                Json?    // string[] – multiple addresses to notify
  notifyDepositOver500  Boolean  @default(true)
  notifyWithdrawOver500 Boolean  @default(true)
  notifyNewAccount      Boolean  @default(true)
  notifyKycReady        Boolean  @default(true)
  updatedAt             DateTime @updatedAt

  @@map("admin_alert_settings")
}
