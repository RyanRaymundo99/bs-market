		{
			"name": "6. Production Webhook - With Signature",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// Validate that test_transaction_id is set",
							"var transactionId = pm.environment.get('test_transaction_id');",
							"if (!transactionId || transactionId === '') {",
							"    console.error('❌ ERROR: test_transaction_id is not set!');",
							"    console.error('Please run \"1. Get Recent Orders\" first to set this variable.');",
							"    throw new Error('test_transaction_id environment variable is not set. Run \"1. Get Recent Orders\" first.');",
							"} else {",
							"    console.log('✅ Using transaction_id:', transactionId);",
							"}",
							"",
							"// Calculate HMAC-SHA256 signature",
							"const crypto = require('crypto');",
							"const secret = pm.environment.get('webhook_secret') || pm.environment.get('secret_key');",
							"",
							"if (!secret) {",
							"    console.log('Warning: webhook_secret or secret_key not set in environment');",
							"} else {",
							"    const body = pm.request.body.raw;",
							"    const signature = crypto.createHmac('sha256', secret)",
							"        .update(body)",
							"        .digest('hex');",
							"    ",
							"    pm.request.headers.add({",
							"        key: 'X-Webhook-Signature',",
							"        value: signature",
							"    });",
							"    ",
							"    console.log('Signature calculated:', signature);",
							"}"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"event\": \"transaction.completed\",\n  \"data\": {\n    \"transaction_id\": \"{{test_transaction_id}}\",\n    \"external_id\": \"purchase_test_{{$timestamp}}\",\n    \"status\": \"COMPLETED\",\n    \"amount\": {{test_amount}},\n    \"currency\": \"BRL\",\n    \"type\": \"PIX\",\n    \"usdt_amount\": {{test_usdt_amount}},\n    \"created_at\": \"{{$isoTimestamp}}\",\n    \"completed_at\": \"{{$isoTimestamp}}\"\n  },\n  \"timestamp\": \"{{$isoTimestamp}}\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{base_url}}/api/webhooks/nutzpay",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"webhooks",
						"nutzpay"
					]
				},
				"description": "Production webhook with HMAC-SHA256 signature. Uses real order ID. Requires 'webhook_secret' or 'secret_key' environment variable. The signature is automatically calculated in the pre-request script."
			},
			"response": []
		},
