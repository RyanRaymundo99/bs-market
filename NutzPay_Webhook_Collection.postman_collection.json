						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					},
					{
						"key": "x-test-webhook",
						"value": "true",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"event\": \"transaction.completed\",\n  \"data\": {\n    \"transaction_id\": \"{{test_transaction_id}}\",\n    \"external_id\": \"purchase_test_{{$timestamp}}\",\n    \"status\": \"COMPLETED\",\n    \"amount\": {{test_amount}},\n    \"currency\": \"BRL\",\n    \"type\": \"PIX\",\n    \"usdt_amount\": {{test_usdt_amount}},\n    \"created_at\": \"{{$isoTimestamp}}\",\n    \"completed_at\": \"{{$isoTimestamp}}\"\n  },\n  \"timestamp\": \"{{$isoTimestamp}}\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{base_url}}/api/webhooks/nutzpay",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"webhooks",
						"nutzpay"
					]
				},
				"description": "Test webhook for a completed transaction. Uses real order ID from 'Get Recent Orders'. This will update the order status to COMPLETED and credit the user's balance."
			},
			"response": []
