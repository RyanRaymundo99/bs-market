{
	"info": {
		"_postman_id": "nutzpay-webhook-collection",
		"name": "NutzPay Webhook Tests",
		"description": "Collection for testing NutzPay webhook endpoint with various transaction scenarios. IMPORTANT: Run 'Get Recent Orders' first to get real order IDs, then use those IDs in the webhook tests.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "0. Login (Required for Authentication)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"// Check if login was successful",
							"if (pm.response.code === 200) {",
							"    var jsonData = pm.response.json();",
							"    if (jsonData.success) {",
							"        console.log('✅ Login successful!');",
							"        console.log('Session cookie should be automatically saved by Postman');",
							"        ",
							"        // Extract session ID if available",
							"        if (jsonData.sessionId) {",
							"            pm.environment.set('session_id', jsonData.sessionId);",
							"            console.log('✅ Session ID:', jsonData.sessionId);",
							"        }",
							"    } else {",
							"        console.log('❌ Login failed:', jsonData.error);",
							"    }",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"{{user_email}}\",\n  \"password\": \"{{user_password}}\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{base_url}}/api/auth/custom-login",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"auth",
						"custom-login"
					]
				},
				"description": "**REQUIRED: Run this first to authenticate!** This will log you in and set the session cookie. Update `user_email` and `user_password` in your environment variables. Postman will automatically save the session cookie for subsequent requests."
			},
			"response": []
		},
		{
			"name": "1. Get Recent Orders (Run This After Login!)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"// Extract first order's externalOrderId and set as environment variable",
							"if (pm.response.code === 200) {",
							"    var jsonData = pm.response.json();",
							"    if (jsonData.orders && jsonData.orders.length > 0) {",
							"        // Find first order with externalOrderId",
							"        var orderWithId = null;",
							"        for (var i = 0; i < jsonData.orders.length; i++) {",
							"            var order = jsonData.orders[i];",
							"            if (order.externalOrderId) {",
							"                orderWithId = order;",
							"                break;",
							"            }",
							"        }",
							"        ",
							"        if (orderWithId) {",
							"            pm.environment.set('test_transaction_id', orderWithId.externalOrderId);",
							"            pm.environment.set('test_order_id', orderWithId.id);",
							"            pm.environment.set('test_amount', orderWithId.total);",
							"            pm.environment.set('test_usdt_amount', orderWithId.amount);",
							"            console.log('✅ Set test_transaction_id to:', orderWithId.externalOrderId);",
							"            console.log('✅ Set test_order_id to:', orderWithId.id);",
							"            console.log('✅ Set test_amount to:', orderWithId.total);",
							"            console.log('✅ Set test_usdt_amount to:', orderWithId.amount);",
							"        } else {",
							"            // Try to use deposit externalId as fallback",
							"            var orderWithDeposit = null;",
							"            for (var i = 0; i < jsonData.orders.length; i++) {",
							"                var order = jsonData.orders[i];",
							"                if (order.deposit && order.deposit.externalId) {",
							"                    orderWithDeposit = order;",
							"                    break;",
							"                }",
							"            }",
							"            ",
							"            if (orderWithDeposit) {",
							"                pm.environment.set('test_transaction_id', orderWithDeposit.deposit.externalId);",
							"                pm.environment.set('test_order_id', orderWithDeposit.id);",
							"                pm.environment.set('test_amount', orderWithDeposit.total);",
							"                pm.environment.set('test_usdt_amount', orderWithDeposit.amount);",
							"                console.log('⚠️ Using deposit externalId as fallback:', orderWithDeposit.deposit.externalId);",
							"            } else {",
							"                console.log('❌ ERROR: No orders found with externalOrderId or deposit.externalId');",
							"                console.log('Please create an order first, or manually set test_transaction_id in environment');",
							"                pm.environment.unset('test_transaction_id');",
							"            }",
							"        }",
							"    } else {",
							"        console.log('⚠️ Warning: No orders found. Create an order first!');",
							"        pm.environment.unset('test_transaction_id');",
							"    }",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/api/debug/orders?limit=10",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"debug",
						"orders"
					],
					"query": [
						{
							"key": "limit",
							"value": "10",
							"description": "Number of orders to fetch"
						}
					]
				},
				"description": "**IMPORTANT: Run this after logging in!** This fetches recent orders and automatically sets the `test_transaction_id` environment variable to the first order's `externalOrderId`. This ID is then used in all webhook test requests. **You must run '0. Login' first** to get authenticated. Postman will automatically use the session cookie from the login request."
			},
			"response": []
		},
		{
			"name": "2. Test Webhook - Completed Transaction",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// Validate that test_transaction_id is set",
							"var transactionId = pm.environment.get('test_transaction_id');",
							"if (!transactionId || transactionId === '') {",
							"    console.error('❌ ERROR: test_transaction_id is not set!');",
							"    console.error('Please run \"1. Get Recent Orders\" first to set this variable.');",
							"    throw new Error('test_transaction_id environment variable is not set. Run \"1. Get Recent Orders\" first.');",
							"} else {",
							"    console.log('✅ Using transaction_id:', transactionId);",
							"}"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response has success field\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('success');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
