					"raw": "{\n  \"event\": \"transaction.completed\",\n  \"data\": {\n    \"status\": \"COMPLETED\",\n    \"amount\": 8.24,\n    \"currency\": \"BRL\"\n  },\n  \"timestamp\": \"{{$isoTimestamp}}\"\n}",
