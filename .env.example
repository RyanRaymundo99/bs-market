# Copy to .env / .env.local and fill in real values. Never commit secrets.

# Database (Neon / Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Better Auth — use a long random secret in production
AUTH_SECRET=""
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Payments
PAYMENT_PROVIDER="mercadopago"
MERCADOPAGO_PUBLIC_KEY=""
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_CLIENT_ID=""
MERCADOPAGO_CLIENT_SECRET=""
PAYMENT_WEBHOOK_SECRET=""

# Email (optional — password reset / notifications)
RESEND_API_KEY=""
FROM_EMAIL="noreply@example.com"

# App URLs / support (shown in UI)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional: browser-visible auth base (defaults to same-origin)
NEXT_PUBLIC_BETTER_AUTH_URL=""
NEXT_PUBLIC_SUPPORT_EMAIL=""
NEXT_PUBLIC_SUPPORT_WHATSAPP=""

# Webhook URL override for payment provider callbacks (optional)
# PAYMENT_WEBHOOK_URL=""

# SMS (production uses TextBelt chain; see src/lib/sms-production.ts)
TEXTBELT_API_KEY=""

# Admin bootstrap / recovery (leave false in production unless locked down)
ALLOW_ADMIN_PASSWORD_RESET="false"

# Demo / behavior toggles
DEMO_MODE="false"
USE_REALTIME_RATES=""

# Stablecoin ledger (optional overrides)
STABLECOIN_USDC_DEBIT_USDT_PER_USDC=""
NEXT_PUBLIC_STABLECOIN_USDC_DEBIT_USDT_PER_USDC=""

# Deposit addresses (optional — overrides defaults in code)
# DEPOSIT_ADDRESS_USDT_TRC20=""
# DEPOSIT_ADDRESS_ERC20=""

# Optional: allow GET /api/debug/webhooks in production when header matches
# DEBUG_WEBHOOKS_ENDPOINT_SECRET=""
