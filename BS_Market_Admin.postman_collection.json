{
  "info": {
    "_postman_id": "bs-market-admin-001",
    "name": "BS Market - Admin Management",
    "description": "Collection for managing BS Market admin user creation and authentication",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Admin Management",
      "item": [
        {
          "name": "Create Admin User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 && pm.response.json().success) {",
                  "    const credentials = pm.response.json().credentials;",
                  "    console.log('⚠️ IMPORTANT: Save these credentials!');",
                  "    console.log('Email:', credentials.email);",
                  "    console.log('Password:', credentials.password);",
                  "    ",
                  "    // Set as environment variable for easy access",
                  "    pm.environment.set('admin_email', credentials.email);",
                  "    pm.environment.set('admin_password', credentials.password);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/create-admin",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "create-admin"]
            },
            "description": "Creates a new admin user with secure random password.\n\n**Requirements:**\n- Set ALLOW_ADMIN_CREATION=true in Vercel environment variables\n- Redeploy your application\n\n**Response includes:**\n- Admin email (admin@bsmarket.com.br)\n- Secure random 16-character password\n- Security instructions\n\n**⚠️ IMPORTANT:** Save the password immediately - it will not be shown again!"
          },
          "response": []
        },
        {
          "name": "Check Admin Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/auth/check-admin",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "check-admin"]
            },
            "description": "Checks if admin user exists and its current status."
          },
          "response": []
        },
        {
          "name": "Diagnose Admin",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/auth/diagnose-admin",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "diagnose-admin"]
            },
            "description": "Comprehensive diagnosis of admin user setup, including:\n- Email check\n- Admin ID check\n- Password status\n- Issues and solutions"
          },
          "response": []
        },
        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 && pm.response.json().success) {",
                  "    const sessionId = pm.response.json().user?.id;",
                  "    console.log('Login successful!');",
                  "    console.log('Session created for:', pm.response.json().user?.email);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"{{admin_email}}\",\n    \"password\": \"{{admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/auth/admin-login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "admin-login"]
            },
            "description": "Login as admin user. Uses credentials from environment variables."
          },
          "response": []
        },
        {
          "name": "Reset Admin Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"password\": \"YourNewSecurePassword123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/auth/reset-admin-password",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "reset-admin-password"]
            },
            "description": "Resets admin password.\n\n**Requirements:**\n- Set ALLOW_ADMIN_PASSWORD_RESET=true in Vercel environment variables\n- Admin user must exist\n- Password must be at least 8 characters"
          },
          "response": []
        }
      ],
      "description": "Endpoints for managing the admin user account"
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "https://bsmarket.com.br",
      "type": "string"
    },
    {
      "key": "admin_email",
      "value": "admin@bsmarket.com.br",
      "type": "string"
    },
    {
      "key": "admin_password",
      "value": "",
      "type": "string"
    }
  ]
}
